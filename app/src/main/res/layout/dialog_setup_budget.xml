<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/themeCardBg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Budget Setup"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Section 1: Global Monthly Budget -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Global Monthly Budget"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etGlobalBudget"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/spinner_bg"
            android:hint="Global budget limit (e.g. 20000)"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveGlobalBudget"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/primary"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/divider" />

    <!-- Section 2: Category Budget -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Category Budget"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Category Dropdown and Amount Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Spinner
            android:id="@+id/spinBudgetCategory"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.2"
            android:background="@drawable/spinner_bg" />

        <EditText
            android:id="@+id/etCategoryBudget"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="0.8"
            android:layout_marginStart="8dp"
            android:background="@drawable/spinner_bg"
            android:hint="Amount"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveCategoryBudget"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/primary"
        android:text="Set Category Budget"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/divider" />

    <!-- Section 3: Active Category Budgets -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Active Category Budgets"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategoryBudgetsList"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:scrollbars="vertical" />
</LinearLayout>
